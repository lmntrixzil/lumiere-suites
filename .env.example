# Copy to .env.local and fill in. Everything is optional in development:
# without keys the site uses a local JSON store, simulated payments and logged emails.

NEXT_PUBLIC_SITE_URL=https://lumieresuites.ng

# Admin dashboard (/admin)
ADMIN_PASSWORD=change-me
ADMIN_SECRET=a-long-random-string

# Supabase (data + file storage). Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (https://dashboard.paystack.com/#/settings/developers)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Flutterwave (https://app.flutterwave.com/dashboard/settings/apis)
NEXT_PUBLIC_FLW_PUBLIC_KEY=
FLW_SECRET_KEY=

# Email via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="Lumière Suites <bookings@lumieresuites.ng>"
BOOKINGS_INBOX=bookings@lumieresuites.ng
